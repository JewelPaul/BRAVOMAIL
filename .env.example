# ==============================================================================
# BravoMail Environment Configuration Template
# Copy this file to .env for local development or set these variables in your
# deployment provider (Render, Railway, Fly.io, Vercel, GitHub Actions).
# NEVER commit real production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Client-side, Public)
# Note: Variables prefixed with VITE_ are exposed to the public browser client.
# ------------------------------------------------------------------------------
# Set this to your deployed BravoMail backend URL (without trailing slash).
# In local development: http://localhost:3001
# In production on GitHub Pages: https://your-backend-service.onrender.com
VITE_API_BASE_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Server-side, Private)
# Keep these values private on your backend server.
# ------------------------------------------------------------------------------
# Port for the backend server to listen on (default: 3001)
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# 32+ character random secret used for encrypting session tokens (AES-256-GCM)
# Generate a secure secret in terminal: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-secure-random-32-byte-hex-string-in-production

# Temporary email session lifetime in minutes (default: 60)
SESSION_EXPIRY_MINUTES=60

# Allowed CORS origins for backend (comma-separated if multiple)
# In production: https://jewelpaul.github.io
CORS_ORIGIN=https://jewelpaul.github.io,http://localhost:8080,http://localhost:5173

# Optional: Custom Mail.tm API endpoint if self-hosting or using a custom proxy
MAILTM_API_BASE=https://api.mail.tm
